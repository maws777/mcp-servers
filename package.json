{
  "name": "mcp-servers",
  "private": true,
  "type": "module",
  "description": "MCP servers for my personal apps, deployed on my AWS landing zone",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:store": "vitest run --project store",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
